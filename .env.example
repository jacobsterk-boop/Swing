# Copy this file to `.env` and fill in your keys. `.env` is gitignored.

# Financial data — required. Free tier works: https://finnhub.io
FINNHUB_API_KEY=

# Claude — required (the agents run on Anthropic models).
# https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: only needed if your TradingAgents version uses OpenAI for the
# embeddings / memory layer even when the agents themselves run on Claude.
# OPENAI_API_KEY=
